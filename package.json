{
  "name": "sparklean-website",
  "private": true,
  "description": "Static site; build step generates sitemap.xml from netlify.toml.",
  "scripts": {
    "build": "node scripts/generate-pages-redirects.mjs && node scripts/generate-sitemap.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "pages-redirects": "node scripts/generate-pages-redirects.mjs",
    "schema:sync": "node scripts/sync-entity-schema.mjs",
    "testimonials:sync": "node scripts/sync-testimonials.mjs",
    "test:ads": "node scripts/test-google-ads-conversion.mjs",
    "test:paid-intake": "node scripts/test-paid-intake-funnel.mjs",
    "test:leads-store": "node scripts/test-leads-store.mjs",
    "test:conversion-adversarial": "node scripts/test-conversion-boundary-adversarial.mjs",
    "test:funnel": "npm run test:ads && npm run test:paid-intake && npm run test:leads-store && npm run test:conversion-adversarial",
    "test:schema": "node scripts/test-entity-schema.mjs",
    "test:testimonials": "node scripts/test-testimonials.mjs",
    "test:referral": "node scripts/test-referral-recurring.mjs",
    "gen:trust-pages": "node scripts/gen-trust-layer-pages.mjs"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.12"
  }
}
