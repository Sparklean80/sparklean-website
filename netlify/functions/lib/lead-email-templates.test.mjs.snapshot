:.06em;text-transform:uppercase;\\">Bedrooms</td><td style=\\"padding:10px 14px;border-bottom:1px solid #353024;color:#F9F7F3;font-size:14px;\\">4</td></tr><tr><td style=\\"padding:10px 14px;border-bottom:1px solid #3A3528;color:#B8B4AE;font-size:12px;letter-spacing:.06em;text-transform:uppercase;\\">Bathrooms</td><td style=\\"padding:10px 14px;border-bottom:1px solid #353024;color:#F9F7F3;font-size:14px;\\">3</td></tr></table></td></tr></table><table role=\\"presentation\\" width=\\"100%\\" cellpadding=\\"0\\" cellspacing=\\"0\\" border=\\"0\\" style=\\"margin-bottom:18px;\\"><tr><td style=\\"font-family:Georgia,serif;font-size:13px;color:#B8A47A;letter-spacing:.12em;text-transform:uppercase;padding-bottom:8px;border-bottom:1px solid #4A4335;\\">Requested services</td></tr><tr><td style=\\"padding:0;\\"><table role=\\"presentation\\" width=\\"100%\\" cellpadding=\\"0\\" cellspacing=\\"0\\" border=\\"0\\" style=\\"background:#0E0E0E;border-radius:4px;\\"><tr><td style=\\"padding:10px 14px;border-bottom:1px solid #3A3528;color:#B8B4AE;font-size:12px;letter-spacing:.06em;text-transform:uppercase;\\">Cadence</td><td style=\\"padding:10px 14px;border-bottom:1px solid #353024;color:#F9F7F3;font-size:14px;\\">Weekly</td></tr></table></td></tr></table><table role=\\"presentation\\" width=\\"100%\\" cellpadding=\\"0\\" cellspacing=\\"0\\" border=\\"0\\" style=\\"margin-bottom:18px;\\"><tr><td style=\\"font-family:Georgia,serif;font-size:13px;color:#B8A47A;letter-spacing:.12em;text-transform:uppercase;padding-bottom:8px;border-bottom:1px solid #4A4335;\\">Scheduling notes</td></tr><tr><td style=\\"padding:0;\\"><table role=\\"presentation\\" width=\\"100%\\" cellpadding=\\"0\\" cellspacing=\\"0\\" border=\\"0\\" style=\\"background:#0E0E0E;border-radius:4px;\\"><tr><td style=\\"padding:10px 14px;border-bottom:1px solid #3A3528;color:#B8B4AE;font-size:12px;letter-spacing:.06em;text-transform:uppercase;\\">Residential notes</td><td style=\\"padding:10px 14px;border-bottom:1px solid #353024;color:#F9F7F3;font-size:14px;\\">Two dogs; gate code on file.</td></tr></table></td></tr></table>\\n<table role=\\"presentation\\" width=\\"100%\\" cellpadding=\\"0\\" cellspacing=\\"0\\" border=\\"0\\">\\n<tr><td style=\\"font-family:Georgia,serif;font-size:13px;color:#B8A47A;letter-spacing:.12em;text-transform:uppercase;padding-bottom:8px;border-bottom:1px solid #4A4335;\\">Internal AI summary</td></tr>\\n<tr><td style=\\"padding:14px 0 8px 0;font-family:Georgia,'Times New Roman',serif;font-size:15px;line-height:1.65;color:#F9F7F3;font-style:italic;\\">They requested recurring residential service for a occupied home in Naples. Preferred weekly cadence with attention to kitchen and primary bath.</td></tr>\\n</table>\\n<p style=\\"margin:20px 0 0 0;font-family:Arial,sans-serif;font-size:11px;line-height:1.5;color:#8A8680;\\">Use Call / Reply above to reach the client. Do not discuss pricing in email—coordinate by phone.</p>\\n</td></tr>\\n</table>\\n</td></tr></table>\\n</body></html>"
