`;

exports[`snapshot — quote lead email HTML 1`] = `
"<!DOCTYPE html>\\n<html><head><meta charset=\\"utf-8\\"><meta name=\\"viewport\\" content=\\"width=device-width,initial-scale=1\\"><title>Lead</title></head>\\n<body style=\\"margin:0;padding:0;background:#0A0A0A;color:#F9F7F3;\\">\\n<table role=\\"presentation\\" width=\\"100%\\" cellpadding=\\"0\\" cellspacing=\\"0\\" border=\\"0\\" style=\\"background:#0A0A0A;padding:24px 12px;\\">\\n<tr><td align=\\"center\\">\\n<table role=\\"presentation\\" width=\\"100%\\" style=\\"max-width:600px;background:#121212;border:1px solid #4A4335;border-radius:4px;overflow:hidden;\\">\\n<tr><td style=\\"padding:28px 28px 20px 28px;text-align:center;border-bottom:1px solid #403A2C;\\">\\n<img src=\\"https://cdn.prod.website-files.com/69b2101ca55e3c42c4f97568/69b21b5c7958824a1f172b0f_sparklean-logo-transparent.png\\" alt=\\"Sparklean\\" width=\\"180\\" style=\\"display:block;margin:0 auto 16px auto;height:auto;\\">\\n<p style=\\"margin:0;font-family:Georgia,'Times New Roman',serif;font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:#D4BF96;\\">Private intake brief</p>\\n<p style=\\"margin:8px 0 0 0;font-family:Georgia,serif;font-size:20px;color:#F9F7F3;\\">Luxury residential cleaning</p>\\n<p style=\\"margin:10px 0 0 0;font-family:Arial,sans-serif;font-size:12px;color:#A8A49E;\\">Lead ID <span style=\\"color:#B8A47A;\\">lead-test-00000000-0000-4000-8000-000000000001</span> · Mon, Sep 1, 2026, 6:30 PM EDT</p>\\n<p style=\\"margin:8px 0 0 0;font-family:Arial,sans-serif;font-size:11px;color:#A8A49E;\\">Lead ID: lead-test · gclid: present</p>\\n</td></tr>\\n<tr><td style=\\"padding:20px 24px 8px 24px;\\"><tr><td style=\\"padding:0 0 20px 0;font-family:Arial,sans-serif;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:#D4BF96;\\">HIGH VALUE</td></tr>\\n<table role=\\"presentation\\" width=\\"100%\\" cellpadding=\\"0\\" cellspacing=\\"0\\" border=\\"0\\" style=\\"margin-bottom:18px;\\">\\n<tr><td style=\\"font-family:Georgia,serif;font-size:13px;color:#B8A4